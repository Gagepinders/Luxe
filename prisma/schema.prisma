// Luxe Landscape & Snow — CRM data model

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (SQLite has no native enums, so we use string unions in TS) ----------
// PropertyType: "residential" | "commercial"
// QuoteStatus: "draft" | "sent" | "won" | "lost"
// JobStatus: "scheduled" | "in_progress" | "completed" | "cancelled"
// RecurrenceFrequency: "none" | "weekly" | "biweekly" | "monthly" | "on_demand"
// ServiceCategory: "landscaping" | "snow_removal"

model Customer {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  type        String   @default("residential") // residential | commercial
  status      String   @default("active") // active | inactive | lead
  pipelineStage String @default("new") // new | contacted | estimate_scheduled | estimate_sent | won | lost
  source      String? // how they heard about us: referral, google, website, etc.
  tags        String? // comma separated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]
  quotes     Quote[]
  jobs       Job[]
  invoices   Invoice[]
  activities Activity[]

  @@index([name])
  @@index([pipelineStage])
}

model Property {
  id          String  @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String   @default("Main Property") // e.g. "Home", "Rental - Maple St"
  addressLine String
  city        String   @default("")
  state       String   @default("VT")
  zip         String   @default("")
  lat         Float?
  lng         Float?

  lawnSqft      Float?
  driveSqft     Float?
  walkwaySqft   Float?
  mulchSqft     Float?
  totalAcres    Float?
  boundaryGeoJson String? // GeoJSON polygon(s) captured from the measuring tool
  measurements  String?  // JSON array of {label, type, sqft} for multiple measured areas

  gateCode     String?
  accessNotes  String?
  hazards      String?  // dogs, sprinkler heads, etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes Quote[]
  jobs   Job[]

  @@index([customerId])
}

model ServiceType {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String  // landscaping | snow_removal
  defaultUnit  String  @default("visit") // visit, sqft, hour, month
  defaultRate  Float   @default(0)
  active       Boolean @default(true)

  lineItems QuoteLineItem[]
  jobs      Job[]
}

model Quote {
  id          String   @id @default(cuid())
  number      Int      @default(0) // sequential display number, assigned on create
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  title       String   @default("")
  status      String   @default("draft") // draft | sent | won | lost
  sentAt      DateTime?
  decidedAt   DateTime?
  lostReason  String?
  validUntil  DateTime?
  notes       String?
  publicToken String?  @unique // lets the customer view + approve/decline online, no login

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems QuoteLineItem[]
  jobs      Job[]

  @@index([customerId])
  @@index([status])
}

model QuoteLineItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  description String
  quantity    Float   @default(1)
  unit        String  @default("visit")
  unitPrice   Float   @default(0)
  sortOrder   Int     @default(0)
}

model Job {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  title         String
  status        String    @default("scheduled") // scheduled | in_progress | completed | cancelled
  scheduledDate DateTime
  startTime     String?   // "08:00"
  endTime       String?   // "10:00"
  crew          String?   // free-text crew/assignee name(s)
  price         Float     @default(0)
  recurrence    String    @default("none") // none | weekly | biweekly | monthly | on_demand
  routeOrder    Int?      // manual/optimized stop order within the day
  completedAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos   JobPhoto[]
  expenses JobExpense[]
  invoices Invoice[]

  @@index([customerId])
  @@index([propertyId])
  @@index([scheduledDate])
  @@index([status])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename  String // stored filename on the uploads volume
  caption   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model JobExpense {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String
  category    String   @default("material") // material | fuel | labor | equipment | other
  amount      Float
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model Invoice {
  id         String    @id @default(cuid())
  number     Int       @default(0)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  status      String    @default("draft") // draft | sent | paid | overdue
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  notes       String?
  publicToken String?   @unique // lets the customer view the invoice online, no login

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]

  @@index([customerId])
  @@index([status])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Float  @default(1)
  unit        String @default("visit")
  unitPrice   Float  @default(0)
  sortOrder   Int    @default(0)
}

model EmailCampaign {
  id             String    @id @default(cuid())
  subject        String
  body           String
  audience       String    @default("all") // all | active | lead | won | lost | pipeline:<stage> | tag:<tag>
  status         String    @default("draft") // draft | sending | sent | failed
  recipientCount Int       @default(0)
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Activity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String   // note | call | email | quote | job | status_change
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model MaterialStock {
  id         String   @id @default(cuid())
  name       String // e.g. "Mulch", "Rock salt", "Ice melt"
  unit       String   @default("unit") // yards, bags, gallons, tons
  quantity   Float    @default(0)
  lowStockAt Float    @default(0) // flag as low stock at or below this level
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Equipment {
  id             String    @id @default(cuid())
  name           String // "Toro Z Master", "F-250 Plow Truck"
  category       String    @default("equipment") // vehicle | mower | plow | trimmer | other
  status         String    @default("active") // active | maintenance | retired
  lastServicedAt DateTime?
  nextServiceDue DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CompanyProfile {
  id          String @id @default("default")
  name        String @default("Luxe Landscape & Snow")
  tagline     String @default("Dependable Property Care for Homes in Chittenden County")
  phone       String @default("+1-802-735-7110")
  email       String @default("Luxelandscapevt@gmail.com")
  addressLine String @default("16 Oakwood Lane")
  city        String @default("Essex Junction")
  state       String @default("VT")
  zip         String @default("05452")
  lat         Float  @default(44.5063689)
  lng         Float  @default(-73.0590180)
  serviceArea String @default("Chittenden County, VT — Burlington, Essex Junction, Williston & surrounding")
  website     String @default("luxelandscapevt.com")
  googleReviewUrl String? // link customers land on for "leave us a review"
}

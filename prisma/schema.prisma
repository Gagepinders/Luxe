// Luxe Landscape & Snow — CRM data model

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (SQLite has no native enums, so we use string unions in TS) ----------
// PropertyType: "residential" | "commercial"
// QuoteStatus: "draft" | "sent" | "won" | "lost"
// JobStatus: "scheduled" | "in_progress" | "completed" | "cancelled"
// RecurrenceFrequency: "none" | "weekly" | "biweekly" | "monthly" | "on_demand"
// ServiceCategory: "landscaping" | "snow_removal"

model Customer {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  type        String   @default("residential") // residential | commercial
  status      String   @default("active") // active | inactive | lead
  tags        String? // comma separated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]
  quotes     Quote[]
  jobs       Job[]
  activities Activity[]

  @@index([name])
}

model Property {
  id          String  @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String   @default("Main Property") // e.g. "Home", "Rental - Maple St"
  addressLine String
  city        String   @default("")
  state       String   @default("VT")
  zip         String   @default("")
  lat         Float?
  lng         Float?

  lawnSqft      Float?
  driveSqft     Float?
  walkwaySqft   Float?
  totalAcres    Float?
  boundaryGeoJson String? // GeoJSON polygon(s) captured from the measuring tool
  measurements  String?  // JSON array of {label, type, sqft} for multiple measured areas

  gateCode     String?
  accessNotes  String?
  hazards      String?  // dogs, sprinkler heads, etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes Quote[]
  jobs   Job[]

  @@index([customerId])
}

model ServiceType {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String  // landscaping | snow_removal
  defaultUnit  String  @default("visit") // visit, sqft, hour, month
  defaultRate  Float   @default(0)
  active       Boolean @default(true)

  lineItems QuoteLineItem[]
  jobs      Job[]
}

model Quote {
  id          String   @id @default(cuid())
  number      Int      @default(0) // sequential display number, assigned on create
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  title       String   @default("")
  status      String   @default("draft") // draft | sent | won | lost
  sentAt      DateTime?
  decidedAt   DateTime?
  lostReason  String?
  validUntil  DateTime?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems QuoteLineItem[]
  jobs      Job[]

  @@index([customerId])
  @@index([status])
}

model QuoteLineItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  description String
  quantity    Float   @default(1)
  unit        String  @default("visit")
  unitPrice   Float   @default(0)
  sortOrder   Int     @default(0)
}

model Job {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  title         String
  status        String    @default("scheduled") // scheduled | in_progress | completed | cancelled
  scheduledDate DateTime
  startTime     String?   // "08:00"
  endTime       String?   // "10:00"
  crew          String?   // free-text crew/assignee name(s)
  price         Float     @default(0)
  recurrence    String    @default("none") // none | weekly | biweekly | monthly | on_demand
  routeOrder    Int?      // manual/optimized stop order within the day
  completedAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([propertyId])
  @@index([scheduledDate])
  @@index([status])
}

model Activity {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String   // note | call | email | quote | job | status_change
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CompanyProfile {
  id          String @id @default("default")
  name        String @default("Luxe Landscape & Snow")
  tagline     String @default("Dependable Property Care for Homes in Chittenden County")
  phone       String @default("+1-802-735-7110")
  email       String @default("Luxelandscapevt@gmail.com")
  serviceArea String @default("Chittenden County, VT — Burlington, Essex Junction, Williston & surrounding")
  website     String @default("luxelandscapevt.com")
}

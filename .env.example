# Copy this file to .env and fill in real values for local development.

# Postgres connection string (e.g. from neon.tech, Supabase, or a local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/luxe_crm"

# Optional: a direct (non-pooled) connection string for running migrations
# against a pooled provider like Neon/Vercel Postgres. Falls back to
# DATABASE_URL when not set — fine to leave commented out or set to the same
# value as DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/luxe_crm"

# Visiting /api/seed?key=<this value> (re)loads the demo data. Leave unset to
# disable the endpoint entirely.
SEED_SECRET="choose-a-password"
